# Dragon Editor 编辑器配置
# 统一编码、换行符与缩进风格

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown：保留行尾空格（用于硬换行）
[*.md]
trim_trailing_whitespace = false

# YAML
[*.yaml]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# Python
[*.py]
indent_size = 4
