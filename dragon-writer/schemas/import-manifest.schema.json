{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragon-writer.local/schemas/import-manifest.schema.json",
  "title": "Dragon Writer Legacy Import Manifest",
  "type": "object",
  "required": ["schemaVersion", "firstChapter", "lastChapter", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "4.0"},
    "firstChapter": {"type": "integer", "minimum": 1},
    "lastChapter": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter", "path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "chapter": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
