{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragon-writer.local/schemas/chapter-audit.schema.json",
  "title": "Dragon Writer Chapter Audit Manifest",
  "type": "object",
  "required": ["schemaVersion", "chapter", "draftSha256", "intentSha256", "gateReportSha256", "overlapReportSha256", "informedAudit", "coldRead"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"enum": ["4.0", "4.1"]},
    "chapter": {"type": "integer", "minimum": 1},
    "draftSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intentSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gateReportSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "overlapReportSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "informedAudit": {"$ref": "#/$defs/auditResult"},
    "coldRead": {"$ref": "#/$defs/auditResult"}
  },
  "$defs": {
    "auditResult": {
      "type": "object",
      "required": ["status", "reportPath", "reportSha256"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "reportPath": {"type": "string", "minLength": 1},
        "reportSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "packetManifestPath": {"type": "string", "minLength": 1},
        "packetManifestSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "packetSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
