{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragon-writer.local/schemas/chapter-transaction.schema.json",
  "title": "Dragon Writer Chapter Transaction",
  "type": "object",
  "required": ["schemaVersion", "chapter", "state", "events"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"enum": ["4.0", "4.1"]},
    "chapter": {"type": "integer", "minimum": 1},
    "state": {"enum": ["prepared", "drafted", "gated", "audited", "closed", "reopened", "legacy_closed", "imported_closed"]},
    "draftSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "finalSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "legacyMigration": {"type": "boolean"},
    "legacySourcePath": {"type": "string", "minLength": 1},
    "legacySourceSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assuranceLevel": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "from", "to", "timestamp", "eventHash"],
        "additionalProperties": true,
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "timestamp": {"type": "string", "minLength": 1},
          "previousEventHash": {"type": "string"},
          "eventHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
